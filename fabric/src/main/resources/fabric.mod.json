{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    {
      "name": "${author}",
      "contact": {
        "homepage": "${author_website}"
      }
    }
  ],
  "contact": {
    "homepage": "https://modrinth.com/project/${modrinth_id}",
    "sources": "${source_url}",
    "issues": "${issues_url}",
    "website": "${author_website}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.modrinth": "https://modrinth.com/project/${modrinth_id}"
      }
    }
  },
  "license": "${license}",
  "icon": "assets/${mod_id}/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "${entrypoint}"
    ]
  },
  "mixins": [
  ],
  "depends": {
    "fabricloader": "*",
    "minecraft": "${minecraft}",
    "java": "${java}",
    "fabric-api": "*"
  }
}
